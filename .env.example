# ======================================================================
# CONFIGURACIÓN DE VARIABLES DE ENTORNO — HOGAR EXPRESS
# ======================================================================
# Copiar este archivo a ".env" en la raíz del proyecto para desarrollo local.
# IMPORTANTE: No comitear el archivo ".env" real con secretos de producción.

# --- DOCKER ---
COMPOSE_PROJECT_NAME=hogar_express

# --- BASE DE DATOS (POSTGRESQL) ---
POSTGRES_DB=hogar_express
POSTGRES_USER=hogar_express
POSTGRES_PASSWORD=change_me_in_production_12345
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_EXPOSED_PORT=5432

# --- BACKEND (DJANGO) ---
# Opciones de settings: config.settings.development | config.settings.production | config.settings.test
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=change_me_secret_key_django_mvp_2026
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:8000
DJANGO_LOG_LEVEL=INFO

# --- SUPERUSER DJANGO ---
# Credenciales para la creación inicial automática de la cuenta administradora
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.test
DJANGO_SUPERUSER_PASSWORD=admin_password_safe

# --- CORS & FRONTEND ---
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- PARÁMETROS DEL NEGOCIO ---
MAX_UPLOAD_SIZE_MB=10
ENABLE_DEMO_DATA=true
ENABLE_ROLE_SIMULATOR=true

# --- FRONTEND (VITE) ---
VITE_API_BASE_URL=/api/v1
VITE_USE_MOCKS=false
VITE_ENABLE_ROLE_SIMULATOR=true
